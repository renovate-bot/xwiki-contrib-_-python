<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.xwiki.contrib.python</groupId>
    <artifactId>python</artifactId>
    <version>1.0.1-SNAPSHOT</version>
  </parent>
  <artifactId>python3-packaging</artifactId>
  <name>Python 3 Packaging</name>
  <description>The Python packaging standards (versions, dependencies, compatibility) evaluated for the Python 3 runtime.</description>
  <properties>
    <xwiki.jacoco.instructionRatio>0.97</xwiki.jacoco.instructionRatio>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.xwiki.contrib.python</groupId>
      <artifactId>python3-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xwiki.commons</groupId>
      <artifactId>xwiki-commons-environment-api</artifactId>
      <version>${commons.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xwiki.contrib.python</groupId>
      <artifactId>python3-engine</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Testing dependencies -->
    <dependency>
      <groupId>org.xwiki.commons</groupId>
      <artifactId>xwiki-commons-tool-test-component</artifactId>
      <version>${commons.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.build.directory}/generated-resources/packaging</directory>
      </resource>
    </resources>
    <plugins>
      <!-- Embed the wheel of the packaging library, downloaded from PyPI -->
      <plugin>
        <groupId>com.googlecode.maven-download-plugin</groupId>
        <artifactId>download-maven-plugin</artifactId>
        <version>1.13.0</version>
        <executions>
          <execution>
            <id>download-packaging</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>wget</goal>
            </goals>
            <configuration>
              <url>https://files.pythonhosted.org/packages/py3/p/packaging/packaging-${python.packaging.version}-py3-none-any.whl</url>
              <outputDirectory>${project.build.directory}/generated-resources/packaging/python</outputDirectory>
              <outputFileName>packaging.whl</outputFileName>
              <sha256>${python.packaging.sha256}</sha256>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
